# POS-Zetu secrets. Copy to /home/frappe/.poszetu.env on the server and lock it down:
#   cp poszetu.env.example /home/frappe/.poszetu.env
#   chown frappe:frappe /home/frappe/.poszetu.env && chmod 600 /home/frappe/.poszetu.env
# Never commit the real file. *.env is git-ignored.

SMTP_HOST=mail-eu.smtp2go.com
SMTP_PORT=2525
SMTP_USER=homezetu.com
SMTP_PASS=change-me
FROM_EMAIL=homezetu@homezetu.com
ADMIN_EMAIL=dkarigi@gmail.com

# MariaDB root password. Only needed by upgrade.sh to restore backups on rollback.
DB_ROOT_PASSWORD=change-me
